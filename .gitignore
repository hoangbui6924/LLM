# Trọng số model — 640 MB, không đưa vào git. Muốn giữ thì sao lưu riêng.
checkpoints/
*.safetensors
*.npz

# Cache và file tạm
.cache/
__pycache__/
.pytest_cache/
*.pyc

# Bí mật
.env

# ---- ViMultiAgent ----------------------------------------------------------
# Mô hình PhoBERT đã fine-tune: 517 MB, vượt giới hạn GitHub.
# Dựng lại bằng: python ml/build_dataset.py && python ml/train_phobert.py (~12 phút)
ViMultiAgent/backend/ml/phobert_router/

# Node
node_modules/
dist/

# SQLite lịch sử hỏi đáp — dữ liệu chạy, không phải mã nguồn
*.db
*.sqlite3

# Dataset phân loại môn học VẪN ĐƯA VÀO git (84 KB): đây là dữ liệu do nhóm tự
# xây dựng, là bằng chứng cho phần học sâu của đề tài. Chỉ trọng số mô hình mới
# phải loại, vì 515 MB vượt giới hạn 100 MB mỗi file của GitHub.

# ViMultiAgent — biến môi trường
# Copy file này thành .env rồi chỉnh. Để trống hết vẫn chạy được.

# ---- Ollama (bắt buộc, chạy cục bộ, không cần API key) ----------------------
OLLAMA_HOST=http://localhost:11434

# Đo trên RTX 3060 Laptop 6 GB VRAM:
#   qwen3:4b -> nằm trọn GPU, 74 tok/s, cả luồng ~22 giây  (ĐẠT KPI 45 giây)
#   qwen3:8b -> tràn 27% xuống CPU, 16 tok/s, cả luồng ~80 giây (TRƯỢT KPI)
# Máy có từ 10 GB VRAM trở lên thì đổi cả hai dòng dưới sang qwen3:8b để tăng
# chất lượng lời giải. Đừng đặt hai dòng khác model nhau nếu VRAM không chứa nổi
# cả hai cùng lúc — Ollama sẽ nạp đi nạp lại, chậm hơn nhiều so với dùng một model.
VMA_MODEL_HEAVY=qwen3:4b
VMA_MODEL_LIGHT=qwen3:4b

# ---- Ngân sách thời gian ---------------------------------------------------
VMA_SLA_SECONDS=45
VMA_AGENT_TIMEOUT=25
# Số lần Verify được yêu cầu Subject Agent giải lại.
VMA_MAX_RETRY_ROUNDS=1

VMA_TEMPERATURE=0.2
VMA_NUM_CTX=8192

# ---- Cơ sở dữ liệu ---------------------------------------------------------
VMA_DB_PATH=vimultiagent.db

# ---- CORS ------------------------------------------------------------------
VMA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

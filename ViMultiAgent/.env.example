# ==============================================================================
# ViMultiAgent — biến môi trường
# Copy sang .env rồi điền. KHÔNG BAO GIỜ commit file .env.
# ==============================================================================

# ---- Chế độ chạy -------------------------------------------------------------
# cloud_default | local_offline  (khớp profile trong configs/models.yaml)
VMA_PROFILE=cloud_default
# fast | balanced | rigorous
VMA_STRATEGY=balanced


# ==============================================================================
# LLM PROVIDERS — cần TỐI THIỂU MỘT cái, hoặc dùng Ollama (không cần key)
# ==============================================================================

# ---- Ollama (cục bộ, KHÔNG cần API key) --------------------------------------
# Đủ để chạy toàn bộ hệ thống offline. Đánh đổi: chậm hơn SLA 45s trên 6GB VRAM.
OLLAMA_BASE_URL=http://localhost:11434

# ---- Groq (có free tier) — provider chính cho KPI độ trẻ ---------------------
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=

# ---- OpenRouter (có model :free) — dùng để ĐA DẠNG HOÁ model Verifier -------
# Lấy tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Together AI (tuỳ chọn) — nhiều model open-weights lớn ------------------
# Lấy tại: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=


# ==============================================================================
# TUỲ CHỌN — hệ thống chạy bình thường khi để trống
# ==============================================================================

# ---- WolframAlpha: đối chứng thứ 3 cho bài khó (free ~2000 lượt/tháng) ------
# Lấy tại: https://developer.wolframalpha.com/access
# Để trống => tool tự động bị vô hiệu hoá, không lỗi.
WOLFRAM_APP_ID=

# ---- HuggingFace: tải model embedding / dataset gated (token MIỄN PHÍ) ------
# Lấy tại: https://huggingface.co/settings/tokens
HF_TOKEN=

# ---- Weights & Biases: log đường cong loss khi huấn luyện (tuỳ chọn) --------
# Không có thì tự fallback sang tensorboard cục bộ.
WANDB_API_KEY=
WANDB_PROJECT=vimultiagent


# ==============================================================================
# HẠ TẦNG CỤC BỘ — docker-compose, KHÔNG phải dịch vụ bên thứ 3
# ==============================================================================

# ---- Qdrant (vector DB, chạy trong docker trên máy bạn) --------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vma_knowledge

# ---- Langfuse (quan trắc, self-host trong docker) --------------------------
# Key do CHÍNH Langfuse cục bộ của bạn sinh ra, không phải mua của ai.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# ==============================================================================
# KIỂM SOÁT CHI PHÍ — quan trọng khi chạy benchmark
# ==============================================================================

# Cache mọi lượt gọi LLM ra đĩa => chạy lại benchmark KHÔNG tốn thêm tiền.
VMA_LLM_CACHE=true
VMA_LLM_CACHE_DIR=.cache/llm

# Ngắt cứng khi vượt ngân sách trong một lần chạy (USD ước tính).
VMA_BUDGET_USD_PER_RUN=5.0

# Giới hạn nhịp gọi để không đụng trần free tier.
VMA_MAX_CONCURRENCY=4
VMA_RETRY_ON_RATELIMIT=true
